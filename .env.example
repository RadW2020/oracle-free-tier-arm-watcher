PORT=8088
METRICS_INTERVAL=15m
OCI_TENANCY_ID=your_tenancy_ocid
OCI_USER_ID=your_user_ocid
OCI_FINGERPRINT=your_fingerprint
OCI_REGION=eu-madrid-3

OCI_PRIVATE_KEY_PATH=/keys/key.pem

# Clave heredada: pasa a ser el cliente "legacy" con permiso de lectura
# (es la que usan los checks de Checkly).
API_KEY=your_api_key_here

# Clientes con nombre y permisos para /v1 y /mcp: nombre:permiso+permiso:clave
# Permisos: read, refresh (forzar una lectura nueva de OCI), audit (ver /v1/audit)
# API_CLIENTS=claude:read+refresh:genera_con_openssl_rand_hex_32,raul:read+refresh+audit:otra_clave

# Fuente de datos: oci (por defecto) o fixture (demo sintético, sin credenciales)
# DATA_SOURCE=fixture
# FIXTURE_SCENARIO=incident-2026-09-17
# Tiempo mínimo entre refrescos pedidos desde fuera (protege la API de OCI)
# REFRESH_COOLDOWN=1m

# --- Lo que sigue NO lo usa el watcher: son credenciales de otras
# herramientas del repo (CLI de Checkly, Coolify, Postiz). No se las des a
# un agente: la de Checkly lee las variables `locked` en claro.

CHECKLY_API_KEY="your_checkly_api_key"
CHECKLY_ACCOUNT_ID="your_checkly_account_id"

COOLIFY_ROOT_API_TOKEN=your_coolify_api_token

# OCI Object Storage for Postiz Media
OCI_OBJECT_STORAGE_NAMESPACE=your_oci_namespace
OCI_OBJECT_STORAGE_BUCKET=postiz-media
OCI_OBJECT_STORAGE_ACCESS_KEY=your_access_key
OCI_OBJECT_STORAGE_SECRET_KEY=your_secret_key
OCI_OBJECT_STORAGE_ENDPOINT=https://your_namespace.compat.objectstorage.eu-madrid-3.oraclecloud.com
OCI_OBJECT_STORAGE_PUBLIC_URL=https://objectstorage.eu-madrid-3.oraclecloud.com/n/your_namespace/b/postiz-media/o/
